{
  "name": "orquidea-api",
  "version": "1.0.0",
  "description": "API REST — Sistema de Gestión Funeraria Orquídea",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pm2:start": "pm2 start src/server.js --name orquidea-api",
    "pm2:stop": "pm2 stop orquidea-api",
    "pm2:restart": "pm2 restart orquidea-api",
    "migrate": "node scripts/migrate.js",
    "migrate:rollback": "node scripts/migrate.js rollback"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/static": "^7.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "puppeteer": "^22.0.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "pm2": "^5.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
