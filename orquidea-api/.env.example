# ── Servidor ────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orquidea_db
DB_USER=orquidea_user
DB_PASSWORD=TU_PASSWORD_AQUI

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTE_SECRET_POR_UNO_SEGURO_EN_PRODUCCION
JWT_EXPIRES_IN=8h

# ── Uploads ──────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./src/uploads

# ── WhatsApp ─────────────────────────────────────────
WA_ENABLED=false
WA_SESSION_PATH=./wa-session

# ── URLs ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:3001
